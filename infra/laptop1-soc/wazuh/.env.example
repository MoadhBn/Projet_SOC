# Copy to .env next to docker-compose.yml (same folder as the official
# wazuh-docker/single-node files), replace the placeholders, then: chmod 600 .env
# The real .env is never committed (.gitignore).
# Rules: 12 to 64 characters, upper and lower case, digit and symbol;
# use only . - _ ! @ + as symbols (no $, quotes, #, backslash or space).
# For API_PASSWORD these rules are enforced: the manager does not start otherwise.

# Wazuh indexer user "admin" (also used to log in to the dashboard)
INDEXER_PASSWORD=change-me-Admin.1
# Wazuh indexer user "kibanaserver" (dashboard to indexer)
DASHBOARD_PASSWORD=change-me-Kibana.2
# Wazuh server API user "wazuh-wui" (dashboard to manager API)
API_PASSWORD=change-me-Api.3
