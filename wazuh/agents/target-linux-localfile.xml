<!--
  Extra log sources for the Linux target (target-linux, 10.10.20.20).
  Reference only: the 4.14.9 installer added both entries to
  /var/ossec/etc/ossec.conf by itself because Apache was already installed.
  On a machine where they are missing, paste them inside the <ossec_config>
  block, then:
    systemctl restart wazuh-agent
  Use cases: UC-03 web exploitation (Apache logs).
  Authentication logs (UC-01 SSH brute force) are collected by the default configuration.
-->
<localfile>
  <log_format>apache</log_format>
  <location>/var/log/apache2/access.log</location>
</localfile>

<localfile>
  <log_format>apache</log_format>
  <location>/var/log/apache2/error.log</location>
</localfile>
